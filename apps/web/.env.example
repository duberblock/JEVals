# Web app server-side configuration.
# These values are read by the Next.js server (route handlers) only —
# do NOT prefix them with NEXT_PUBLIC_ so they never reach the client bundle.
# Copy this file to .env.local for local overrides.

# Base URL of the jevals FastAPI service forwarded by the /api/v1 proxy.
# API_BASE_URL=http://localhost:8000

# Optional Basic Auth credentials injected server-side by the proxy when the
# API enforces authentication.
# AUTH_USER=
# AUTH_PASS=
