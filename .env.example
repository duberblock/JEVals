# Local / deployment configuration — canonical names mirror
# apps/api/app/core/config.py. Deployment contract (values, volume path,
# migration step): docs/DEPLOYMENT.md.
#
# Provider credentials (emulator, JEV baseline, judge, independent) are
# configured from the app's Settings screen — encrypted at rest, effective
# immediately, no redeploy. The provider env vars still work as a
# deployment pre-seed (Settings values override them); their full surface
# lives in config.py and docs/DEPLOYMENT.md.

# Database (defaults to a local SQLite file):
# DATABASE_URL=sqlite:///./jevals.db

# Master key for credentials saved through the settings UI (Fernet,
# urlsafe base64 32 bytes; unset -> settings.key file beside the DB):
# SETTINGS_ENCRYPTION_KEY=

# Execution admission control (a value <= 0 disables that dimension):
# MAX_EXECUTION_REQUEST_BYTES=1048576
# MAX_CONCURRENT_EXECUTIONS=2
# MAX_EXECUTIONS_PER_MINUTE=10

# HTTP basic auth for the API:
# AUTH_USER=
# AUTH_PASS=
# API_PORT=8000
