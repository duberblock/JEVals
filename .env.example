# Backend configuration — canonical names mirror app/core/config.py Settings.
# Deployment contract (values, volume path, migration step): docs/DEPLOYMENT.md.
# DATABASE_URL=sqlite:///./jevals.db
# EMULATOR_URL=
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_STRUCTURED_OUTPUTS=true
# DEFAULT_MODEL=
# AUTH_USER=
# AUTH_PASS=
# API_PORT=8000

# Fully local provider setup (see README — "Running fully local"):
#   emulator leg -> python3 scripts/local_emulator.py   (Simple Jev adapter)
#   LLM legs     -> Ollama or any local OpenAI-compatible server
# EMULATOR_URL=http://localhost:8100
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b
# OPENAI_STRUCTURED_OUTPUTS=false
