# Backend configuration — canonical names mirror app/core/config.py Settings.
# Deployment contract (values, volume path, migration step): docs/DEPLOYMENT.md.
# DATABASE_URL=sqlite:///./jevals.db
# EMULATOR_URL=
# EMULATOR_API_KEY=
# EMULATOR_MODEL=
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_STRUCTURED_OUTPUTS=true
# Per-leg overrides (win over the shared OPENAI_* pair):
# JUDGE_API_KEY=
# JUDGE_BASE_URL=
# JUDGE_MODEL=
# INDEPENDENT_API_KEY=
# INDEPENDENT_BASE_URL=
# INDEPENDENT_MODEL=
# Master key for credentials saved through the settings UI (Fernet,
# urlsafe base64 32 bytes; unset -> settings.key file beside the DB):
# SETTINGS_ENCRYPTION_KEY=
# DEFAULT_MODEL=
# AUTH_USER=
# AUTH_PASS=
# API_PORT=8000

# Fully local provider setup (see README — "Running fully local"):
#   emulator leg -> python3 scripts/local_emulator.py   (Simple Jev adapter)
#   LLM legs     -> Ollama or any local OpenAI-compatible server
# EMULATOR_URL=http://localhost:8100
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b
# OPENAI_STRUCTURED_OUTPUTS=false
